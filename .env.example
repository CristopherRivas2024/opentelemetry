# ============================================================
# Central Observability Stack - Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ============================================================

# Grafana admin credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme

# Email used for Grafana alert contact point
GF_ALERTING_CONTACT_EMAIL=alerts@example.com

# Tempo: trace retention (e.g. 168h = 7 days, 336h = 14 days)
TEMPO_RETENTION_DAYS=168h

# Loki: log retention (e.g. 336h = 14 days, 720h = 30 days)
LOKI_RETENTION_DAYS=336h

# Prometheus: metrics retention (e.g. 30d, 90d)
PROMETHEUS_RETENTION=30d

# IP of the central observability server (used by service agents)
CENTRAL_SERVER_IP=0.0.0.0
