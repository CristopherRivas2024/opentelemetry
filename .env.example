# ============================================================
# Central Observability Stack - Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ============================================================

# Grafana admin credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme

# Email used for Grafana alert contact point
GF_ALERTING_CONTACT_EMAIL=alerts@example.com

# Tempo: trace retention (e.g. 168h = 7 days, 336h = 14 days)
TEMPO_RETENTION_DAYS=168h

# Loki: log retention (e.g. 336h = 14 days, 720h = 30 days)
LOKI_RETENTION_DAYS=336h

# Prometheus: metrics retention (e.g. 30d, 90d)
PROMETHEUS_RETENTION=30d

# IP of the central observability server (used by service agents)
CENTRAL_SERVER_IP=0.0.0.0

# ── Host port mapping ────────────────────────────────────────────────────────
# Override these only if the default ports clash with other services on the
# host. The container-internal ports never change. Bind addresses are fixed
# in docker-compose.yml: external services on 0.0.0.0, internals on 127.0.0.1.

# OTel Collector OTLP HTTP receiver (external — services ship telemetry here)
OTEL_OTLP_HTTP_PORT=4318
# OTel Collector OTLP gRPC receiver (internal only)
OTEL_OTLP_GRPC_PORT=4317
# OTel Collector self-metrics (scraped by Prometheus)
OTEL_METRICS_PORT=8888

# Tempo HTTP API (internal only)
TEMPO_HTTP_PORT=3200
# Loki HTTP API (internal only)
LOKI_HTTP_PORT=3100
# Prometheus UI / API (internal only)
PROMETHEUS_PORT=9090
# Grafana UI (external)
GRAFANA_PORT=3000

# ── Backups ──────────────────────────────────────────────────────────────────
# Directory on the host where volume tarballs are written.
# Must be writable by the user running Docker (or the Docker daemon on Linux).
BACKUP_DIR=/var/backups/observability

# Number of newest tarballs to retain per volume (minimum 1).
# Older tarballs beyond this count are automatically pruned after each run.
BACKUP_RETAIN=14
